# Where the Delta tables live. Use a local path for development,
# or s3://bucket/prefix against MinIO or real S3.
LAKE_ROOT=data/lake

# Where raw CSV drops land.
RAW_DIR=data/raw

# Only needed when LAKE_ROOT points at S3.
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_REGION=us-east-1

# Optional. When set, the publish task writes gold tables into this database.
# Leave it unset to skip publishing.
# WAREHOUSE_DSN=postgresql+psycopg2://airflow:airflow@localhost:5432/analytics
